#cloud-config
users:
  - name: $QBEE_DEMO_USER
    lock_passwd: false
    passwd: $QBEE_DEMO_PASSWORD_HASH
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash

write_files:
  - path: /etc/issue
    content: |
      Debian GNU/Linux 12 \n \l

      ***************************
      *
      * Qbee demo system:       
      *                         
      * Username: $QBEE_DEMO_USER          
      * Password: $QBEE_DEMO_PASSWORD      
      *
      ***************************

ssh_pwauth: True
bootcmd:
  - |
    if [ -n "${QBEE_DEMO_DEVICE_HUB_CA_CERT}" ]; then
      echo "${QBEE_DEMO_DEVICE_HUB_CA_CERT}" | base64 -d > /etc/qbee/ppkeys/ca.cert
    fi
  - |
    if [ ! -f /etc/qbee/qbee-agent.json ]; then
      if [ -c /dev/tpmrm0 ]; then
        qbee-agent bootstrap -k $QBEE_DEMO_BOOTSTRAP_KEY \
          --device-hub-host $QBEE_DEMO_DEVICE_HUB_HOST \
          --device-hub-port $QBEE_DEMO_DEVICE_HUB_PORT \
          --tpm-device /dev/tpmrm0 2>&1 > /dev/null
      else
        qbee-agent bootstrap -k $QBEE_DEMO_BOOTSTRAP_KEY \
          --device-hub-host $QBEE_DEMO_DEVICE_HUB_HOST \
          --device-hub-port $QBEE_DEMO_DEVICE_HUB_PORT 2>&1 > /dev/null
      fi
    fi

